# ── JSONBin.io (required for form submission + admin panel) ──────────────────
# 1. Sign up free at https://jsonbin.io
# 2. Create a new Bin with initial value: []
# 3. Copy your Bin ID from the URL bar after saving
# 4. Copy your Master Key from Account → API Keys

VITE_JSONBIN_BIN_ID=your_bin_id_here
VITE_JSONBIN_MASTER_KEY=$2a$10$your_master_key_here

# ── Admin panel ───────────────────────────────────────────────────────────────
# Credentials are set in src/data/event.js (admin.username / admin.password)
# Change them before going live!
